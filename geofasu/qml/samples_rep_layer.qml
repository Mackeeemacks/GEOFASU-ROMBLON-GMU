    <constraint desc="Invalid Entry!" exp="CASE&#xd;&#xa;WHEN &quot;orig_wkt&quot; IS NOT NULL THEN&#xd;&#xa;&#x9;trim(&quot;BSN&quot;) = trim(&quot;BSN_Orig&quot;)&#xd;&#xa;&#xd;&#xa;ELSE&#xd;&#xa;&#x9;regexp_match(BSN,'^[0-9]{4}$')&#xd;&#xa;&#x9;&#xd;&#xa;END" field="BSN"/>
    <constraint desc="Invalid Entry!" exp="CASE&#xd;&#xa;WHEN &quot;orig_wkt&quot; IS NOT NULL THEN&#xd;&#xa;&#x9;trim(&quot;HUSN&quot;) = trim(&quot;HUSN_Orig&quot;)&#xd;&#xa;&#xd;&#xa;ELSE&#xd;&#xa;&#x9;regexp_match(HUSN,'^[0-9]{4}$')&#xd;&#xa;&#x9;&#xd;&#xa;END" field="HUSN"/>
    <constraint desc="Invalid Entry" exp="CASE&#xd;&#xa;WHEN &quot;orig_wkt&quot; IS NOT NULL THEN&#xd;&#xa;&#x9;trim(&quot;HSN&quot;) = trim(&quot;HSN_Orig&quot;)&#xd;&#xa;&#xd;&#xa;ELSE&#xd;&#xa;&#x9;regexp_match(HSN,'^[0-9]{4}$')&#xd;&#xa;&#x9;&#xd;&#xa;END" field="HSN"/>
    <constraint desc="" exp="" field="BSN_Orig"/>
    <constraint desc="" exp="" field="HUSN_Orig"/>
    <constraint desc="" exp="" field="HSN_Orig"/>
    <constraint desc="Must be in upper case and enter valid name!" exp="CASE&#xd;&#xa;WHEN &quot;orig_wkt&quot; IS NOT NULL THEN&#xd;&#xa;    trim(&quot;HH_Head&quot;) = trim(&quot;HH_Head_Orig&quot;)&#xd;&#xa;&#xd;&#xa;ELSE&#xd;&#xa;    &quot;HH_Head&quot; IS NOT NULL&#xd;&#xa;    AND (&#xd;&#xa;        trim(&quot;HH_Head&quot;) IN ('VHU','VRH','NUR')&#xd;&#xa;        OR (&#xd;&#xa;            length(trim(&quot;HH_Head&quot;)) > 5&#xd;&#xa;            AND regexp_match(&#xd;&#xa;                trim(&quot;HH_Head&quot;),&#xd;&#xa;                '^[A-Z]+( [A-Z]+)*$'&#xd;&#xa;            )&#xd;&#xa;        )&#xd;&#xa;    )&#xd;&#xa;END" field="HH_Head"/>
    <constraint desc="" exp="" field="HH_Head_Orig"/>
    <constraint desc="Enter a valid address!" exp="CASE&#xd;&#xa;WHEN &quot;orig_wkt&quot; IS NOT NULL THEN&#xd;&#xa;&#x9;trim(&quot;Address&quot;)=trim(&quot;Address_Orig&quot;)&#xd;&#xa;ELSE&#xd;&#xa;&#x9;&quot;Address&quot; IS NOT NULL&#xa;&#x9;AND length(trim(&quot;Address&quot;)) > 5&#xa;&#x9;AND regexp_match(&quot;Address&quot;, '^[A-Z0-9 .,/#-]+$')&#xa;END" field="Address"/>
    <constraint desc="" exp="" field="Address_Orig"/>
    <constraint desc="" exp="" field="Remarks"/>
    <constraint desc="" exp="" field="Selected_SSU"/>
    <constraint desc="" exp="" field="inCentroid"/>
    <constraint desc="" exp="" field="orig_wkt"/>
    <constraint desc="Move the geotagged point to the correct location" exp="CASE&#xd;&#xa;&#xd;&#xa;WHEN Selected_SSU in (1,2)&#xd;&#xa;THEN&#xd;&#xa;&#xd;&#xa;    CASE&#xd;&#xa;&#xd;&#xa;    WHEN inCentroid = 2 THEN&#xd;&#xa;&#xd;&#xa;    &quot;Update Codes&quot; in (0,1,2,3,4,5,6,8,9)&#xd;&#xa;&#xd;&#xa;    WHEN inCentroid = 1 THEN&#xd;&#xa;    &quot;Update Codes&quot; in (0,1,2,3,4,5,6,8,9) AND not intersects($geometry, geom_from_wkt(orig_wkt))&#xd;&#xa;&#xd;&#xa;    end&#xd;&#xa;&#xd;&#xa;WHEN Selected_SSU = 3 AND BSN &lt;> '' AND HUSN &lt;> '' AND HSN &lt;> '' AND HH_Head &lt;> '' AND Address &lt;> ''&#xd;&#xa;THEN&#xd;&#xa;&#xd;&#xa;&quot;Update Codes&quot; in (0,1,2,3,4,5,6,8,9)&#xd;&#xa;&#xd;&#xa;end&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;" field="Update Codes"/>
    <constraint desc="" exp="CASE&#xd;&#xa;WHEN &quot;Update Codes&quot; = 2 THEN UC_2_ind in (1,2,3)&#xd;&#xa;else&#xd;&#xa;UC_2_ind is null or UC_2_ind is not NULL&#xd;&#xa;end " field="UC_2_ind"/>
    <constraint desc="" exp="CASE&#xd;&#xa;WHEN &quot;Update Codes&quot; = 6 THEN uc_6_ind in (1,2)&#xd;&#xa;ELSE&#xd;&#xa;uc_6_ind is null or uc_6_ind is not NULL&#xd;&#xa;end " field="uc_6_ind"/>
    <constraint desc="Enter a valid name!" exp="CASE&#xd;&#xa;WHEN &quot;Update Codes&quot; IN (1,3,5) THEN  &quot;n_hhhead&quot; IS NOT NULL and length(n_hhhead) > 5&#xd;&#xa;WHEN &quot;Update Codes&quot; = 2 and (UC_2_ind = 1 or UC_2_ind = 3) THEN&#xd;&#xa;n_hhhead is not NULL and length(n_hhhead) > 5&#xd;&#xa;WHEN &quot;Update Codes&quot; = 6 and uc_6_ind = 1 THEN &quot;n_hhhead&quot; IS NOT NULL and length(n_hhhead) > 5&#xd;&#xa;WHEN &quot;Update Codes&quot; = 2 and UC_2_ind = 2 and  m_uc = 2 THEN length(n_hhhead) > 5&#xd;&#xa;else &#xd;&#xa;&quot;n_hhhead&quot;  is null or  &quot;n_hhhead&quot;  is not NULL&#xd;&#xa;end " field="n_hhhead"/>
    <constraint desc="Enter a valid address!" exp="CASE&#xa;WHEN &quot;Update Codes&quot; = 2 and (UC_2_ind = 2 or UC_2_ind = 3) THEN&#xa;n_address is not NULL and length(n_address) > 5&#xd;&#xa;WHEN &quot;Update Codes&quot; in (1,5) and m_uc_ind = 2 THEN n_address is not NULL and length(n_address) > 5&#xa;else&#xa;n_address is not null or n_address is NULL&#xa;end " field="n_address"/>
    <constraint desc="" exp="" field="n_husn"/>
    <constraint desc="Enter a valid HSN!" exp="CASE&#xd;&#xa;WHEN &quot;Update Codes&quot; in (3,5) THEN n_hsn is not null and regexp_match(n_hsn,'^[0-9]{4}$')&#xd;&#xa;else n_hsn is null or n_hsn is not NULL &#xd;&#xa;&#xd;&#xa;&#xd;&#xa;end " field="n_hsn"/>
    <constraint desc="" exp="CASE&#xd;&#xa;WHEN &quot;Update Codes&quot; IN (1,5) or (&quot;Update Codes&quot; = 2 and UC_2_ind = 2) THEN m_uc_ind is not NULL&#xd;&#xa;ELSE m_uc_ind IS NULL or m_uc_ind IS NOT NULL&#xd;&#xa;END " field="m_uc_ind"/>
    <constraint desc="" exp="CASE&#xd;&#xa;WHEN &quot;Update Codes&quot; = 2 and UC_2_ind = 2 THEN m_uc IS NOT NULL&#xd;&#xa;ELSE&#xd;&#xa;m_uc is null or m_uc is not NULL&#xd;&#xa;end " field="m_uc"/>
  </constraintExpressions>
