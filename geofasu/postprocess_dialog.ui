  <property name="styleSheet">
   <string notr="true">
QDialog{background:#f4f7fb;color:#1f2937;}
QGroupBox{font-weight:700;border:1px solid #cbd5e1;border-radius:9px;margin-top:12px;padding-top:10px;background:white;}
QGroupBox::title{subcontrol-origin:margin;left:14px;padding:0 7px;color:#111827;}
QLineEdit,QPlainTextEdit{border:1px solid #cbd5e1;border-radius:6px;padding:6px 9px;background:white;}
QLineEdit:focus,QPlainTextEdit:focus{border:1px solid #3b82f6;}
QCheckBox{spacing:8px;font-weight:600;}
QPushButton{min-height:28px;max-height:30px;min-width:78px;max-width:118px;padding:3px 10px;border-radius:6px;border:1px solid #b8c2ce;background:#f8fafc;color:#334155;font-weight:600;}
QPushButton:hover{background:#eef2f7;border-color:#94a3b8;}
QPushButton:disabled{background:#f1f5f9;border-color:#e2e8f0;color:#94a3b8;}
QPushButton#btn_browse_excel,QPushButton#btn_browse_validated,QPushButton#btn_browse_output,QPushButton#btn_browse_csdbe_data,QPushButton#btn_browse_dictionary,QPushButton#btn_browse_csconcat{background:#eef2ff;border-color:#c7d2fe;color:#3730a3;}
QPushButton#btn_read_excel{min-width:118px;max-width:118px;background:#2563eb;border-color:#1d4ed8;color:white;font-weight:700;}
QPushButton#btn_read_excel:hover{background:#1d4ed8;}
QPushButton#btn_process_csdbe{min-width:118px;max-width:118px;background:#0f766e;border-color:#0d6962;color:white;font-weight:700;}
QPushButton#btn_process_csdbe:hover{background:#0d6962;}
QPushButton#btn_process_csdbe:disabled{background:#dbe8e6;border-color:#cbdedb;color:#78928e;}
QPushButton#btn_load_all{min-width:190px;max-width:220px;min-height:34px;max-height:36px;background:#15803d;border-color:#166534;color:white;font-size:11pt;font-weight:800;}
QPushButton#btn_load_all:hover{background:#166534;}
QPushButton#btn_load_all:disabled{background:#d8e8dd;border-color:#c7ddce;color:#7e9986;}
QLabel#label_csdbe_status{padding:9px 11px;border:1px solid #bfdbfe;border-radius:6px;background:#eff6ff;color:#1e3a8a;}
QLabel#label_cadcs_instruction{padding:2px 4px;color:#64748b;font-style:italic;}
   </string>
