<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>geofasuDialogBase</class>
 <widget class="QDialog" name="geofasuDialogBase">
  <property name="windowTitle"><string>GEOFASU — PRE-PROCESS</string></property>
  <property name="minimumSize">
   <size><width>980</width><height>720</height></size>
  </property>
  <property name="styleSheet">
   <string notr="true">
QDialog{background:#f4f7fb;color:#1f2937;}
QGroupBox{background:#fff;border:1px solid #cbd5e1;border-radius:9px;margin-top:14px;padding-top:10px;font-weight:700;}
QGroupBox::title{subcontrol-origin:margin;left:14px;padding:0 7px;color:#111827;}
QLineEdit,QComboBox,QTableWidget{background:#fff;border:1px solid #cbd5e1;border-radius:6px;padding:6px 9px;}
QLineEdit,QComboBox{min-height:28px;}
QLineEdit[readOnly="true"]{background:#f8fafc;color:#475569;}
QComboBox{color:#1f2937;}
QComboBox QAbstractItemView{background:#fff;color:#1f2937;border:1px solid #cbd5e1;outline:0;selection-background-color:#dbeafe;selection-color:#111827;}
QHeaderView::section{background:#f1f5f9;color:#334155;border:0;border-right:1px solid #cbd5e1;border-bottom:1px solid #cbd5e1;padding:5px;font-weight:700;}
QTableWidget{alternate-background-color:#f8fafc;gridline-color:#e2e8f0;}
QPushButton{min-height:28px;max-height:30px;min-width:78px;max-width:130px;padding:3px 10px;border-radius:6px;border:1px solid #b8c2ce;background:#f8fafc;color:#334155;font-weight:600;}
QPushButton:hover{background:#eef2f7;border-color:#94a3b8;}
QPushButton:disabled{background:#f1f5f9;border-color:#e2e8f0;color:#94a3b8;}
QPushButton#pbBrowseExcel,QPushButton#pbBrowseOutput{min-width:100px;max-width:100px;background:#eef2ff;border-color:#c7d2fe;color:#3730a3;}
QPushButton#pbLoadSSU{min-width:118px;max-width:118px;background:#2563eb;border-color:#1d4ed8;color:#fff;font-weight:700;}
QPushButton#pbGenerateGeometry{min-width:210px;max-width:240px;min-height:36px;max-height:38px;background:#15803d;border-color:#166534;color:#fff;font-size:11pt;font-weight:800;}
QPushButton#pbInspectQField{min-width:170px;max-width:190px;background:#0f766e;border-color:#0d6962;color:#fff;font-weight:700;}
QPushButton#pbPackageQField{min-width:170px;max-width:190px;background:#7c3aed;border-color:#6d28d9;color:#fff;font-weight:700;}
QPushButton#pbPackageQField:disabled{background:#ede9fe;color:#8b5cf6;border-color:#ddd6fe;}
QLabel#lblQFieldStatus{padding:8px 10px;border:1px solid #bfdbfe;border-radius:6px;background:#eff6ff;color:#1e3a8a;}
   </string>
  </property>

  <layout class="QVBoxLayout" name="verticalLayout">
   <property name="leftMargin"><number>14</number></property>
   <property name="topMargin"><number>10</number></property>
   <property name="rightMargin"><number>14</number></property>
   <property name="bottomMargin"><number>10</number></property>
   <property name="spacing"><number>8</number></property>

   <item>
    <widget class="QLabel" name="label_header">
     <property name="text">
      <string>&lt;h2&gt;GEOFASU Pre-Processing&lt;/h2&gt;&lt;p&gt;Prepare sample geometry, project-specific PSU outputs, and QField field packages.&lt;/p&gt;</string>
     </property>
    </widget>
   </item>

   <item>
    <widget class="QScrollArea" name="scrollArea">
     <property name="widgetResizable"><bool>true</bool></property>
     <property name="frameShape"><enum>QFrame::NoFrame</enum></property>
     <property name="horizontalScrollBarPolicy"><enum>Qt::ScrollBarAlwaysOff</enum></property>
     <property name="verticalScrollBarPolicy"><enum>Qt::ScrollBarAsNeeded</enum></property>

     <widget class="QWidget" name="scrollAreaWidgetContents">
      <property name="geometry">
       <rect><x>0</x><y>0</y><width>940</width><height>1080</height></rect>
      </property>

      <layout class="QVBoxLayout" name="scrollLayout">
       <property name="spacing"><number>10</number></property>

       <item>
        <widget class="QGroupBox" name="group_ssu">
         <property name="title"><string>1 — PSU Master List</string></property>
         <layout class="QGridLayout" name="grid_ssu">
          <property name="horizontalSpacing"><number>10</number></property>
          <property name="verticalSpacing"><number>8</number></property>

          <item row="0" column="0">
           <widget class="QLabel" name="label_project_abbreviation">
            <property name="text"><string>Project abbreviation:</string></property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QLineEdit" name="project_abbreviation">
            <property name="text"><string>LFS</string></property>
            <property name="placeholderText"><string>Examples: LFS, CBMS, FIES</string></property>
            <property name="maxLength"><number>20</number></property>
           </widget>
          </item>
          <item row="0" column="2">
           <widget class="QLabel" name="label_project_hint">
            <property name="text"><string>Used in generated names and paths</string></property>
            <property name="styleSheet">
             <string notr="true">color:#64748b; font-style:italic;</string>
            </property>
           </widget>
          </item>

          <item row="1" column="0">
           <widget class="QLabel" name="label_excel">
            <property name="text"><string>Sample Excel:</string></property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QLineEdit" name="ssu_list_path">
            <property name="placeholderText"><string>Select the sample workbook…</string></property>
           </widget>
          </item>
          <item row="1" column="2">
           <widget class="QPushButton" name="pbBrowseExcel">
            <property name="text"><string>Browse…</string></property>
           </widget>
          </item>
          <item row="2" column="2">
           <widget class="QPushButton" name="pbLoadSSU">
            <property name="text"><string>Read Sample List</string></property>
           </widget>
          </item>

          <columnstretch>0,1,0</columnstretch>
         </layout>
        </widget>
       </item>

       <item>
        <widget class="QGroupBox" name="group_psu">
         <property name="title"><string>2 — PSU Selection</string></property>
         <layout class="QGridLayout" name="grid_psu">
          <item row="0" column="0"><widget class="QLabel" name="label_psu"><property name="text"><string>Selected PSU:</string></property></widget></item>
          <item row="0" column="1" colspan="2"><widget class="QComboBox" name="cbpsu_list"/></item>
          <columnstretch>0,1,0</columnstretch>
         </layout>
        </widget>
       </item>

       <item>
        <widget class="QGroupBox" name="group_output">
         <property name="title"><string>3 — Working Output Folder</string></property>
         <layout class="QGridLayout" name="grid_output">
          <item row="0" column="0"><widget class="QLabel" name="label_output"><property name="text"><string>Output path:</string></property></widget></item>
          <item row="0" column="1"><widget class="QLineEdit" name="output_path"><property name="readOnly"><bool>true</bool></property></widget></item>
          <item row="0" column="2"><widget class="QPushButton" name="pbBrowseOutput"><property name="text"><string>Browse…</string></property></widget></item>
          <columnstretch>0,1,0</columnstretch>
         </layout>
        </widget>
       </item>

       <item>
        <widget class="QGroupBox" name="group_generate">
         <property name="title"><string>4 — Generate PSU Geometry</string></property>
         <layout class="QHBoxLayout" name="layout_generate">
          <item><spacer name="generateSpacer"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
          <item><widget class="QPushButton" name="pbGenerateGeometry"><property name="text"><string>Generate Geometry</string></property></widget></item>
         </layout>
        </widget>
       </item>

       <item>
        <widget class="QGroupBox" name="group_qfield">
         <property name="title"><string>5 — QField Package</string></property>
         <layout class="QVBoxLayout" name="layout_qfield">
          <property name="spacing"><number>8</number></property>

          <item>
           <layout class="QGridLayout" name="grid_qfield_path">
            <item row="0" column="0"><widget class="QLabel" name="label_qfield_path"><property name="text"><string>Package destination:</string></property></widget></item>
            <item row="0" column="1"><widget class="QLineEdit" name="qfield_package_path"><property name="readOnly"><bool>true</bool></property><property name="placeholderText"><string>Select a PSU to determine QField Packages\PSU_&lt;n&gt;</string></property></widget></item>
            <columnstretch>0,1</columnstretch>
           </layout>
          </item>

          <item>
           <layout class="QGridLayout" name="grid_qfield_options">
            <item row="0" column="0"><widget class="QLabel" name="label_extent"><property name="text"><string>Package extent:</string></property></widget></item>
            <item row="0" column="1">
             <widget class="QComboBox" name="cmbQFieldExtent">
              <item><property name="text"><string>Barangay boundary</string></property></item>
              <item><property name="text"><string>Current map canvas</string></property></item>
              <item><property name="text"><string>Entire packaged layers</string></property></item>
             </widget>
            </item>
            <item row="1" column="0" colspan="2"><widget class="QCheckBox" name="chkQFieldValidate"><property name="text"><string>Validate project before packaging</string></property><property name="checked"><bool>true</bool></property></widget></item>
            <item row="2" column="0" colspan="2"><widget class="QCheckBox" name="chkQFieldStyles"><property name="text"><string>Copy styles and project resources</string></property><property name="checked"><bool>true</bool></property></widget></item>
            <item row="3" column="0" colspan="2"><widget class="QCheckBox" name="chkQFieldSnapping"><property name="text"><string>Preserve snapping configuration</string></property><property name="checked"><bool>true</bool></property></widget></item>
            <item row="4" column="0" colspan="2"><widget class="QCheckBox" name="chkQFieldRelativePaths"><property name="text"><string>Make packaged project paths relative</string></property><property name="checked"><bool>true</bool></property></widget></item>
            <columnstretch>0,1</columnstretch>
           </layout>
          </item>

          <item><widget class="QLabel" name="label_layer_plan"><property name="text"><string>Current project layer plan:</string></property></widget></item>
          <item><widget class="QTableWidget" name="tblQFieldLayers"><property name="minimumHeight"><number>180</number></property><property name="maximumHeight"><number>260</number></property></widget></item>

          <item>
           <widget class="QLabel" name="lblQFieldStatus">
            <property name="text"><string>Generate the PSU project, then inspect it for QField package readiness.</string></property>
            <property name="wordWrap"><bool>true</bool></property>
           </widget>
          </item>

          <item>
           <layout class="QHBoxLayout" name="layout_qfield_buttons">
            <item><spacer name="qfieldButtonSpacer"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
            <item><widget class="QPushButton" name="pbInspectQField"><property name="text"><string>Inspect Current Project</string></property></widget></item>
            <item><widget class="QPushButton" name="pbPackageQField"><property name="text"><string>Package for QField</string></property><property name="enabled"><bool>false</bool></property></widget></item>
           </layout>
          </item>

         </layout>
        </widget>
       </item>

       <item><spacer name="bottomSpacer"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>10</height></size></property></spacer></item>
      </layout>
     </widget>
    </widget>
   </item>

   <item>
    <widget class="QDialogButtonBox" name="button_box">
     <property name="standardButtons"><set>QDialogButtonBox::Close</set></property>
    </widget>
   </item>
  </layout>
 </widget>

 <resources/>
 <connections>
  <connection>
   <sender>button_box</sender>
   <signal>rejected()</signal>
   <receiver>geofasuDialogBase</receiver>
   <slot>reject()</slot>
  </connection>
 </connections>
</ui>
